import os
import asyncio
from playwright.async_api import async_playwright

def load_links(filename, default_links):
    if os.path.exists(filename):
        with open(filename, "r", encoding="utf-8") as f:
            lines = [line.strip() for line in f if line.strip()]
            if lines:
                return lines
    return default_links

ACCOUNTS_DATA = [
    {
        "email": os.environ.get("PLAYABL_EMAIL_6", "").strip(),
        "password": os.environ.get("PLAYABL_PASSWORD_6", "").strip(),
        "games": load_links("links_acc6.txt", [
            "https://playabl.ai/en/projects/6ad38fb38db64ac6784b9cf9",
            "https://playabl.ai/en/projects/6ad461387a299068476cf515"
        ])
    }
]

async def run():
    async with async_playwright() as p:
        browser = await p.chromium.launch(
            headless=True,
            args=[
                "--disable-blink-features=AutomationControlled",
                "--no-sandbox"
            ]
        )

        for index, acc in enumerate(ACCOUNTS_DATA, start=6):
            email = acc["email"]
            password = acc["password"]

            if not email or not password:
                print(f"[!] Warning: Skipping Account {index} because credentials are missing.")
                continue

            print("\n==========================================")
            print(f"[+] Processing Account {index} (Original Nav + Smart Logic Test): {email}")
            print(f"[+] Projects: {len(acc['games'])}")
            print("==========================================")

            context = await browser.new_context(
                user_agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36",
                viewport={"width": 1366, "height": 768}
            )
            page = await context.new_page()

            try:
                games = acc["games"]
                if not games:
                    continue

                first_game_url = games[0]
                await page.goto(first_game_url, wait_until="domcontentloaded", timeout=20000)
                await page.wait_for_timeout(1500)

                # 1. تسجيل الدخول إذا لزم الأمر
                if await page.locator('input[type="email"], input[name="email"]').count() > 0:
                    print("  [+] Logging in...")
                    email_input = page.locator('input[type="email"], input[name="email"]').first
                    await email_input.wait_for(state="visible", timeout=5000)
                    await email_input.fill(email)

                    password_input = page.locator('input[type="password"], input[name="password"]').first
                    await password_input.fill(password)

                    submit_btn = page.locator('button[type="submit"]').first
                    if await submit_btn.is_visible():
                        await submit_btn.click()
                    else:
                        await password_input.press("Enter")

                    await page.wait_for_timeout(4000)
                    if "login" in page.url.lower():
                        print(f"  [X] Login failed for Account {index}.")
                        continue
                    print("  [+] Login successful.")
                else:
                    print("  [+] Already logged in.")

                for g_index, url in enumerate(games, start=1):
                    print(f"  [{g_index}/{len(games)}] Updating project: {url}")
                    try:
                        # 2. الدخول لصفحة المشروع (صفحة الشات)
                        await page.goto(url, wait_until="domcontentloaded", timeout=15000)
                        await page.wait_for_timeout(2000)

                        # 3. النقر على زر "تحديث / Update" العلوي للانتقال لصفحة الإعدادات (الطريقة المضمونة)
                        top_update_btn = page.locator('button:has-text("تحديث"), button:has-text("Update"), [role="button"]:has-text("تحديث"), [role="button"]:has-text("Update")').first
                        if await top_update_btn.is_visible(timeout=4000):
                            await top_update_btn.click()
                            await page.wait_for_timeout(2500)
                            print("    [+] Opened settings page.")
                        else:
                            print("    [!] Top update button not found, skipping...")
                            continue

                        # 4. بداخل صفحة الإعدادات: تطبيق المنطق الذكي على اسم المشروع
                        name_input = page.locator('input').first
                        if await name_input.is_visible(timeout=3000):
                            await name_input.click()
                            await page.wait_for_timeout(300)

                            current_val = await name_input.input_value()
                            current_lower = current_val.lower().strip()
                            
                            # تطبيق القاعدة الذكية للتبديل
                            if "notplayabl" in current_lower:
                                new_val = "playabl"
                                print(f"    [-] Found 'notplayabl' -> changing to 'playabl'")
                            elif "playabl" in current_lower:
                                new_val = "notplayabl"
                                print(f"    [+] Found 'playabl' -> changing to 'notplayabl'")
                            else:
                                new_val = "playabl"
                                print(f"    [!] Different name ('{current_val}') -> setting to 'playabl'")

                            # حقن القيمة وإرسال أحداث التغيير للـ React
                            await name_input.evaluate("""(el, val) => {
                                el.focus();
                                el.value = val;
                                el.dispatchEvent(new Event('input', { bubbles: true }));
                                el.dispatchEvent(new Event('change', { bubbles: true }));
                                el.blur();
                            }""", new_val)
                            
                            await page.wait_for_timeout(1000)

                        # 5. النقر على صورة الغلاف (Cover) كضمان إضافي لتنشيط الزر
                        cover_img = page.locator('img[alt*="cover"], img[src*="blob"], div[class*="cover"] img').first
                        if await cover_img.is_visible(timeout=2000):
                            await cover_img.click()
                            await page.wait_for_timeout(1000)

                        # 6. الضغط على زر التحديث الأخضر النهائي في أسفل الصفحة
                        final_update_btn = page.locator('button:has-text("تحديث"), button:has-text("Update"), [role="button"]:has-text("تحديث"), [role="button"]:has-text("Update")').last
                        await final_update_btn.wait_for(state="attached", timeout=5000)

                        if await final_update_btn.is_enabled():
                            await final_update_btn.click()
                            await page.wait_for_timeout(2500)
                            print("    [✓] Updated successfully.")
                        else:
                            await final_update_btn.click(force=True)
                            await page.wait_for_timeout(2500)
                            print("    [✓] Updated successfully (forced).")

                    except Exception as sub_e:
                        print(f"    [!] Failed/Skipped: {sub_e}")

            except Exception as e:
                print(f"    [X] Failed for Account {index}: {str(e)}")
            finally:
                await context.close()

        await browser.close()
        print("\n[+] Test completed!")

if __name__ == "__main__":
    asyncio.run(run())